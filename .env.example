# Required for chesslens.explain (not needed for engine/features/rag phases)
GEMINI_API_KEY=

# Optional. Enables rating-band master-game statistics via the Lichess opening
# explorer instead of the local PGN-derived stats table. Get a token (no scopes
# needed) at https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Optional. Used by `chesslens fetch` to pull your own games as review targets.
LICHESS_USERNAME=
CHESSCOM_USERNAME=
